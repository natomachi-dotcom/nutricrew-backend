ANTHROPIC_API_KEY=your-api-key-here
PORT=3001
CRUD_API_BASE=https://nutricrew-server-1.onrender.com
# Must match the NutriCrew (CRUD backend) INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=replace-with-a-long-random-string-shared-with-NutriCrew
# Google Places API key — required for the premium Nearby tab.
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
# Resend API key and sender address — required for plan emails.
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=NutriCrew <your-verified-sender@yourdomain.com>
